---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'blog' | 'about';
}
const {
  title,
  description = 'Charming 的个人博客。写下一些想法，留给以后，也留给偶然路过的你。',
  active = 'home',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  { label: '首页', href: '/', id: 'home' },
  { label: '文章', href: '/blog/', id: 'blog' },
  { label: '关于', href: '/about/', id: 'about' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title === '首页' ? 'Charming · 个人博客' : `${title} · Charming`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/atom+xml" title="Charming 的文章" href="/atom.xml" />
    <meta property="og:title" content={`${title} · Charming`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('charming-theme');
        document.documentElement.dataset.theme =
          saved === 'dark' || saved === 'light' ? saved : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      跳到主要内容
    </a>
    <div class="site-shell">
      <header class="site-header" data-pagefind-ignore>
        <div class="header-inner">
          <a class="brand" href="/" aria-label="Charming 首页">
            <span class="brand-mark" aria-hidden="true">
              C<span>_</span>
            </span>
            <span>
              Charming<span class="brand-caption">PERSONAL BLOG</span>
            </span>
          </a>
          <nav class="main-nav" aria-label="主导航">
            {navigation.map((item) => (
              <a
                href={item.href}
                class:list={{ 'nav-item': true, active: active === item.id }}
                aria-current={active === item.id ? 'page' : undefined}
              >
                {item.label}
                <span class="nav-dot" aria-hidden="true"></span>
              </a>
            ))}
          </nav>
          <div class="header-actions">
            <a class="search-shortcut" href="/search/" aria-label="搜索公开文章">
              <Icon name="search" size={18} />
              <span>搜索</span>
              <kbd>Ctrl K</kbd>
            </a>
            <button
              id="theme-toggle"
              class="icon-button"
              aria-label="切换深浅主题"
              aria-pressed="false"
              title="切换深浅主题"
            >
              <span class="theme-sun">
                <Icon name="sun" size={18} />
              </span>
              <span class="theme-moon">
                <Icon name="moon" size={18} />
              </span>
            </button>
          </div>
        </div>
      </header>
      <main id="main-content" class="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer" data-pagefind-ignore>
        <div class="footer-inner">
          <div class="footer-top">
            <div>
              <p class="eyebrow">THERE'S ALWAYS ANOTHER PAGE.</p>
              <a class="footer-statement" href="/blog/">
                Keep reading.
                <Icon name="arrowUp" size={56} />
              </a>
            </div>
            <nav class="footer-nav" aria-label="页脚导航">
              <a href="/archives/">
                文章归档
                <Icon name="arrowUp" size={14} />
              </a>
              <a href="/tags/">
                标签索引
                <Icon name="arrowUp" size={14} />
              </a>
              <a href="/atom.xml">
                订阅 RSS
                <Icon name="arrowUp" size={14} />
              </a>
              <a href="https://github.com/Charming-Liu07" target="_blank" rel="noopener noreferrer">
                GitHub
                <Icon name="arrowUp" size={14} />
              </a>
            </nav>
          </div>
          <div class="footer-bottom">
            <a href="/" class="footer-wordmark">
              Charming<span>_</span>
            </a>
            <span>写下来，留给以后。</span>
            <span>© {new Date().getFullYear()} Charming</span>
          </div>
        </div>
      </footer>
    </div>
    <script>
      import '../scripts/site-motion';
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.setAttribute(
        'aria-pressed',
        String(document.documentElement.dataset.theme === 'dark'),
      );
      themeToggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
        try {
          localStorage.setItem('charming-theme', theme);
        } catch {
          /* Theme switching also works when storage is unavailable. */
        }
      });
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          const editing =
            event.target instanceof Element &&
            event.target.closest('input, textarea, select, [contenteditable="true"]');
          if (editing || event.isComposing || document.querySelector('dialog[open]')) return;
          event.preventDefault();
          window.location.href = '/search/';
        }
      });
    </script>
  </body>
</html>
