---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
---

<SiteLayout title="页面未找到">
  <section class="not-found">
    <div class="error-display" aria-hidden="true">
      <span>[ PAGE NOT FOUND ]</span>
      <strong>
        404<span>_</span>
      </strong>
      <span>THE WORDS ARE SOMEWHERE ELSE.</span>
    </div>
    <div class="error-copy">
      <p class="eyebrow">A SMALL DETOUR</p>
      <h1 class="page-title">
        这页文字，
        <br />
        没有找到。
      </h1>
      <p>
        地址可能已经改变，也可能还没有写下。
        <br />
        回到首页，或搜一搜你想读的内容。
      </p>
      <div class="error-actions">
        <a href="/" class="button">
          回到首页
          <Icon name="arrow" size={17} />
        </a>
        <a href="/search/" class="button button-secondary">
          搜索文章
          <Icon name="search" size={17} />
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 100px);
    align-items: center;
    padding: 10px 0 24px;
  }
  .error-display {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 38px 30px;
    color: var(--charcoal);
    background: var(--pink);
    border: 1px solid var(--charcoal);
  }
  .error-display > span {
    font: 9px/1.5 var(--mono);
  }
  .error-display strong {
    font: 500 clamp(80px, 10vw, 132px)/1.3 var(--mono);
    letter-spacing: -0.14em;
    white-space: nowrap;
  }
  .error-display strong span {
    color: #96344f;
  }
  .error-copy .page-title {
    font-size: clamp(35px, 4vw, 52px);
  }
  .error-copy > p:not(.eyebrow) {
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 28px;
  }
  .error-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .error-actions .button {
    padding-inline: 18px;
    gap: 18px;
    font-size: 13px;
  }
  @media (max-width: 700px) {
    .not-found {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .error-display {
      padding: 24px;
    }
    .error-display strong {
      font-size: clamp(82px, 24vw, 132px);
    }
    .error-copy .page-title {
      font-size: 37px;
    }
  }
</style>
