---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = articles.slice(0, 3);
---

<SiteLayout title="首页" active="home">
  <section class="home-hero">
    <div class="hero-text">
      <p class="eyebrow">
        <span class="welcome-dot"></span>欢迎来到我的个人空间
      </p>
      <h1>
        把思考写下来，
        <br />
        让记忆<span>有迹可循。</span>
      </h1>
      <p class="hero-description">
        你好，我是 Charming。
        <br />
        这里存放文字，也为对话里的想法留一处可以回来的地方。
      </p>
      <div class="hero-actions">
        <a href="/blog/" class="button">
          浏览文章 <Icon name="arrow" size={16} />
        </a>
        <a href="/memory/" class="button button-secondary">
          <Icon name="memory" size={16} />
          打开记忆库
        </a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="art-note">
        <span class="note-symbol">✳</span>
        <span class="note-kicker">A SPACE FOR</span>
        <strong>
          Thoughts
          <br />& Memories<span class="note-dot">.</span>
        </strong>
        <span class="note-line"></span>
        <span class="note-bottom">记录当下 · 连接以后</span>
      </div>
      <span class="floating-star">✦</span>
      <span class="art-coordinate">文字 / 思考 / 记忆</span>
    </div>
  </section>
  <div class="home-divider">
    <span>慢慢记录，慢慢生长。</span>
    <span>
      CHARMING'S SPACE <Icon name="sparkle" size={12} />
    </span>
  </div>
  <section class="latest-writing" aria-labelledby="latest-heading">
    <div class="section-heading">
      <h2 id="latest-heading">
        最近的文字 <span class="section-count">{articles.length} 篇</span>
      </h2>
      <a href="/blog/">
        全部文章 <Icon name="arrow" size={14} />
      </a>
    </div>
    <div class="latest-grid">
      {latest.map((article) => (
        <ArticleCard article={article} featured />
      ))}
      <a href="/memory/" class="memory-card card">
        <div class="memory-top">
          <span class="memory-icon">
            <Icon name="memory" size={22} />
          </span>
          <span class="pill">只在本机</span>
        </div>
        <h3>
          让一次对话，
          <br />
          成为下一次思考的起点。
        </h3>
        <p>
          导入对话，整理事实、偏好与决定。
          <br />
          把有用的记忆带进下一次对话。
        </p>
        <span class="memory-link">
          进入记忆库 <Icon name="arrow" size={15} />
        </span>
      </a>
    </div>
  </section>
  <section class="home-note">
    <span class="note-small-icon">
      <Icon name="shield" size={20} />
    </span>
    <div>
      <h2>公开分享文字，私下保存记忆。</h2>
      <p>文章可以被阅读和订阅；对话与记忆只存放在你当前的浏览器里。</p>
    </div>
    <a href="/about/">
      了解这个空间 <Icon name="arrowUp" size={14} />
    </a>
  </section>
</SiteLayout>
<style>
  .home-hero {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 24px;
    align-items: center;
    padding: 9px 0 47px;
  }
  .hero-text .eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    margin-bottom: 23px;
  }
  .welcome-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .hero-text h1 {
    font-size: clamp(34px, 3.6vw, 51px);
    line-height: 1.45;
    letter-spacing: -0.055em;
    margin-bottom: 21px;
    font-weight: 620;
    white-space: nowrap;
  }
  .hero-text h1 span {
    color: var(--accent);
  }
  .hero-description {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.95;
    margin-bottom: 27px;
  }
  .hero-actions {
    display: flex;
    gap: 11px;
    flex-wrap: wrap;
  }
  .hero-art {
    height: 286px;
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .art-note {
    position: relative;
    width: 210px;
    height: 260px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 26px;
    transform: rotate(-7deg);
    box-shadow:
      10px 14px 0 var(--accent-soft),
      0 10px 30px #16231f08;
  }
  .note-symbol {
    position: absolute;
    right: 20px;
    top: 15px;
    color: var(--accent);
    font-size: 28px;
    line-height: 1;
  }
  .note-kicker {
    display: block;
    font-size: 7px;
    letter-spacing: 0.2em;
    color: var(--muted);
    margin: 18px 0 17px;
  }
  .art-note strong {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 27px;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }
  .note-dot {
    color: var(--accent);
  }
  .note-line {
    height: 1px;
    width: 27px;
    background: var(--accent);
    display: block;
    margin: 21px 0 16px;
  }
  .note-bottom {
    font-size: 8px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .orbit {
    position: absolute;
    border: 1px solid var(--border);
    border-radius: 50%;
    z-index: -1;
    transform: rotate(-25deg);
  }
  .orbit-one {
    width: 316px;
    height: 192px;
  }
  .orbit-two {
    width: 270px;
    height: 318px;
    transform: rotate(28deg);
  }
  .floating-star {
    position: absolute;
    right: 5px;
    top: 28px;
    color: var(--accent);
    font-size: 34px;
  }
  .art-coordinate {
    position: absolute;
    bottom: -4px;
    right: 0;
    letter-spacing: 0.14em;
    color: var(--muted);
    font-size: 7px;
  }
  .home-divider {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: 15px;
    color: var(--muted);
    font-size: 9px;
    margin-bottom: 39px;
  }
  .home-divider > span:last-child {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 7px;
    letter-spacing: 0.15em;
  }
  .section-count {
    font-size: 10px;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0;
    margin-left: 8px;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .memory-card {
    padding: 24px 27px;
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 12%, var(--border));
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s;
  }
  .memory-card:hover {
    border-color: var(--accent);
  }
  .memory-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
  }
  .memory-icon {
    color: var(--accent);
  }
  .memory-top .pill {
    background: transparent;
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 15%, var(--border));
    font-size: 8px;
  }
  .memory-card h3 {
    font-size: 18px;
    line-height: 1.65;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  .memory-card p {
    font-size: 10px;
    line-height: 1.9;
    color: var(--muted);
    margin-bottom: 16px;
    flex: 1;
  }
  .memory-link {
    font-size: 10px;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .home-note {
    margin-top: 31px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .note-small-icon {
    width: 39px;
    height: 39px;
    border-radius: 11px;
    background: var(--surface-soft);
    display: grid;
    place-items: center;
    color: var(--muted);
  }
  .home-note h2 {
    font-size: 11px;
    letter-spacing: 0;
    margin-bottom: 4px;
    font-weight: 550;
  }
  .home-note p {
    font-size: 10px;
    color: var(--muted);
    margin: 0;
  }
  .home-note > a {
    margin-left: auto;
    display: flex;
    gap: 7px;
    align-items: center;
    white-space: nowrap;
    font-size: 9px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .hero-text h1 {
      font-size: 39px;
    }
    .hero-art {
      transform: scale(0.9);
    }
    .home-hero {
      gap: 4px;
    }
  }
  @media (max-width: 900px) and (min-width: 761px) {
    .hero-art {
      display: none;
    }
    .home-hero {
      grid-template-columns: 1fr;
    }
    .hero-text h1 {
      font-size: 43px;
    }
    .latest-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 760px) {
    .home-hero {
      grid-template-columns: 1fr;
      padding: 5px 0 31px;
    }
    .hero-text h1 {
      font-size: clamp(30px, 7.7vw, 45px);
      white-space: normal;
      margin-bottom: 17px;
    }
    .hero-text .eyebrow {
      margin-bottom: 18px;
    }
    .hero-art {
      display: none;
    }
    .hero-description {
      font-size: 12px;
    }
    .home-divider {
      margin-bottom: 30px;
      font-size: 8px;
    }
    .home-divider > span:last-child {
      font-size: 6px;
    }
    .latest-grid {
      grid-template-columns: 1fr;
    }
    .home-note {
      align-items: flex-start;
      gap: 11px;
    }
    .home-note > a {
      display: none;
    }
    .home-note p {
      font-size: 9px;
    }
    .note-small-icon {
      flex-shrink: 0;
    }
    .memory-card {
      padding: 23px;
    }
    .memory-card h3 {
      font-size: 20px;
    }
  }
</style>
