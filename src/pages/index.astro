---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = articles.slice(0, 3);
---

<SiteLayout title="首页" active="home">
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="hero-text" data-reveal>
      <p class="eyebrow">
        <span class="status-square" aria-hidden="true"></span>CHARMING'S PERSONAL BLOG
      </p>
      <h1 id="home-heading">
        写下来，
        <br />
        留给以后<span>。</span>
      </h1>
      <p class="hero-description">
        你好，我是 Charming。
        <br />
        这里是我的个人博客，欢迎你来读一读。
      </p>
      <div class="hero-actions">
        <a href="/blog/" class="button">
          开始阅读
          <Icon name="arrow" size={20} />
        </a>
        <a href="/about/" class="hero-about">
          关于这个小站
          <Icon name="arrowUp" size={16} />
        </a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true" data-reveal>
      <span class="art-coordinate">[ A PLACE FOR WORDS ]</span>
      <div class="reader-window">
        <div class="window-bar">
          <span>hello, reader_</span>
          <span class="window-controls">− &nbsp; □ &nbsp; ×</span>
        </div>
        <div class="window-body">
          <svg
            class="pixel-letter"
            viewBox="0 0 200 140"
            fill="currentColor"
            shape-rendering="crispEdges"
          >
            <path d="M40 20h60v20H40zM20 40h20v60H20zM40 100h60v20H40zM100 40h20v20h-20zM100 80h20v20h-20zM140 100h40v20h-40z" />
          </svg>
          <div class="window-copy">
            <span>
              一点记录。
              <br />
              一点想法。
              <br />
              一处可以回来的地方。
            </span>
            <span class="pixel-star">✳</span>
          </div>
        </div>
        <div class="window-status">
          <span>WORDS, AT YOUR OWN PACE.</span>
          <span>↵</span>
        </div>
      </div>
      <span class="art-footnote">Take a moment. Make yourself at home.</span>
    </div>
    <div class="hero-bottom">
      <span>文字 / 想法 / 日常</span>
      <span>SCROLL TO READ ↓</span>
    </div>
  </section>
  <section class="latest-writing" aria-labelledby="latest-heading" data-reveal>
    <div class="writing-intro">
      <p class="eyebrow">THE WRITING INDEX</p>
      <p>偶然路过，也可以慢慢读。</p>
    </div>
    <div class="section-heading">
      <h2 id="latest-heading">
        最近的文字<span class="section-count">{articles.length} 篇文章</span>
      </h2>
      <a href="/blog/">
        全部文章
        <Icon name="arrow" size={18} />
      </a>
    </div>
    {latest.map((article) => (
      <ArticleCard article={article} featured />
    ))}
    {latest.length === 0 && (
      <div class="empty-state">
        <h3>文字还在路上。</h3>
        <p>新的文章会出现在这里。</p>
      </div>
    )}
  </section>
  <section class="home-note" data-reveal>
    <span class="note-symbol" aria-hidden="true">
      ↗
    </span>
    <div>
      <p class="eyebrow">LET'S STAY IN TOUCH</p>
      <h2>下次更新，再见。</h2>
      <p>通过 RSS 订阅，把新文章留到你有空的时候读。</p>
    </div>
    <a class="button button-secondary" href="/atom.xml">
      订阅 RSS
      <Icon name="arrowUp" size={17} />
    </a>
  </section>
</SiteLayout>
<style>
  .home-hero {
    position: relative;
    background: var(--pink);
    color: var(--charcoal);
    border: 1px solid var(--charcoal);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.8fr);
    column-gap: 56px;
    row-gap: 62px;
    padding: 54px 54px 22px;
    margin-top: -28px;
  }
  .hero-text {
    min-width: 0;
  }
  .hero-text .eyebrow {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 10px;
    margin-bottom: 45px;
  }
  .status-square {
    width: 7px;
    height: 7px;
    background: currentColor;
  }
  .hero-text h1 {
    font-size: clamp(58px, 6.4vw, 92px);
    line-height: 1.15;
    letter-spacing: -0.075em;
    font-weight: 500;
    margin-bottom: 30px;
    white-space: nowrap;
  }
  .hero-text h1 span {
    margin-left: -0.08em;
  }
  .hero-description {
    font-size: 16px;
    line-height: 1.9;
    margin-bottom: 28px;
  }
  .hero-actions {
    display: flex;
    gap: 26px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-actions .button {
    background: var(--charcoal);
    color: var(--paper);
    border-color: var(--charcoal);
    gap: 32px;
  }
  .hero-actions .button:hover {
    background: var(--paper);
    color: var(--charcoal);
  }
  .hero-about {
    min-height: 48px;
    display: inline-flex;
    gap: 12px;
    align-items: center;
    font-size: 12px;
  }
  .hero-about:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .home-hero a:focus-visible {
    outline-color: var(--charcoal);
  }
  .hero-art {
    align-self: center;
    min-width: 0;
    transform: translateY(10px);
  }
  .art-coordinate {
    display: block;
    font: 9px/1.5 var(--mono);
    margin: 0 0 16px;
    letter-spacing: 0.04em;
  }
  .reader-window {
    border: 1px solid var(--charcoal);
    box-shadow: 8px 8px 0 #1e1e1e18;
  }
  .window-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 13px;
    background: var(--charcoal);
    color: var(--paper);
    font: 10px var(--mono);
  }
  .window-controls {
    font-size: 11px;
  }
  .window-body {
    padding: 26px 22px 27px;
    background: #f9acc0;
  }
  .pixel-letter {
    display: block;
    width: 82%;
    max-width: 235px;
    height: auto;
    margin: 0 auto 14px;
  }
  .window-copy {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    font-size: 13px;
    line-height: 1.8;
  }
  .pixel-star {
    font-size: 54px;
    line-height: 1;
  }
  .window-status {
    border-top: 1px solid var(--charcoal);
    padding: 9px 13px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font: 8px/1.5 var(--mono);
  }
  .art-footnote {
    display: block;
    margin-top: 20px;
    font: 8px/1.6 var(--mono);
  }
  .hero-bottom {
    grid-column: 1 / -1;
    border-top: 1px solid #1e1e1e55;
    padding-top: 18px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font: 9px/1.6 var(--mono);
  }
  .latest-writing {
    margin-top: 76px;
  }
  .writing-intro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 34px;
  }
  .writing-intro .eyebrow {
    margin: 0;
    color: var(--muted);
  }
  .writing-intro > p:last-child {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }
  .home-note {
    margin-top: 60px;
    border: 1px solid var(--border);
    background: var(--surface-soft);
    padding: 34px 38px;
    display: flex;
    gap: 34px;
    align-items: center;
  }
  .note-symbol {
    font: 50px/1 var(--mono);
    align-self: flex-start;
  }
  .home-note > div {
    flex: 1;
  }
  .home-note .eyebrow {
    font-size: 9px;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .home-note h2 {
    font-size: 25px;
    margin-bottom: 10px;
  }
  .home-note p:last-child {
    font-size: 16px;
    color: var(--muted);
    margin: 0;
  }
  .home-note .button {
    flex-shrink: 0;
  }
  @media (max-width: 1100px) {
    .home-hero {
      padding: 42px 36px 22px;
      column-gap: 36px;
    }
    .hero-text h1 {
      font-size: clamp(52px, 6.2vw, 76px);
    }
  }
  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
      column-gap: 24px;
    }
    .hero-text h1 {
      font-size: 56px;
    }
    .hero-text .eyebrow {
      font-size: 8px;
    }
    .hero-actions {
      gap: 12px;
    }
    .hero-about {
      font-size: 11px;
    }
    .window-body {
      padding: 20px 16px;
    }
    .pixel-star {
      font-size: 38px;
    }
    .window-copy {
      font-size: 11px;
    }
    .window-status {
      font-size: 7px;
    }
    .window-controls {
      display: none;
    }
    .home-note {
      padding: 28px;
      gap: 24px;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 700px) {
    .home-hero {
      margin-top: -20px;
      grid-template-columns: minmax(0, 1fr);
      padding: 30px 24px 18px;
      gap: 34px;
    }
    .hero-text .eyebrow {
      font-size: 8px;
      margin-bottom: 30px;
    }
    .hero-text h1 {
      font-size: clamp(38px, 10.6vw, 66px);
      margin-bottom: 24px;
    }
    .hero-description {
      font-size: 16px;
      margin-bottom: 24px;
    }
    .hero-actions {
      gap: 14px;
    }
    .hero-actions .button {
      padding-inline: 16px;
      font-size: 12px;
      gap: 20px;
    }
    .hero-about {
      font-size: 11px;
      gap: 6px;
    }
    .hero-art {
      max-width: 340px;
      width: 100%;
      justify-self: center;
      transform: none;
    }
    .art-coordinate {
      margin-bottom: 10px;
      font-size: 8px;
    }
    .window-body {
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .pixel-letter {
      width: 46%;
      margin: 0;
    }
    .window-copy {
      flex: 1;
      padding: 0;
      font-size: 10px;
    }
    .pixel-star {
      display: none;
    }
    .window-status {
      font-size: 7px;
    }
    .art-footnote {
      font-size: 7px;
      margin-top: 15px;
    }
    .hero-bottom {
      font-size: 8px;
      gap: 10px;
      padding-top: 14px;
    }
    .latest-writing {
      margin-top: 46px;
    }
    .writing-intro {
      margin-bottom: 22px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .writing-intro > p:last-child {
      font-size: 12px;
    }
    .home-note {
      margin-top: 38px;
      padding: 26px 22px;
      gap: 18px;
    }
    .note-symbol {
      font-size: 34px;
    }
    .home-note h2 {
      font-size: 23px;
    }
    .home-note .button {
      margin-left: 52px;
    }
  }
</style>
