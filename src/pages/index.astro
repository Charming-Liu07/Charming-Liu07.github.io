---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MemoryScene from '../components/MemoryScene.astro';
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = articles.slice(0, 3);
---

<SiteLayout title="首页" active="home">
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="hero-text" data-reveal>
      <p class="eyebrow">
        <span class="welcome-dot"></span>欢迎来到我的个人空间
      </p>
      <h1 id="home-heading">
        把思考写下来，
        <br />
        让记忆<span>有迹可循。</span>
      </h1>
      <p class="hero-description">
        你好，我是 Charming。
        <br />
        这里存放文字，也为对话里的想法留一处可以回来的地方。
      </p>
      <div class="hero-actions">
        <a href="/blog/" class="button">
          浏览文章 <Icon name="arrow" size={18} />
        </a>
        <a href="/memory/" class="button button-secondary">
          <Icon name="memory" size={18} />
          打开记忆库
        </a>
      </div>
    </div>
    <div class="hero-art" data-reveal>
      <MemoryScene />
    </div>
  </section>
  <div class="home-divider" data-reveal>
    <span>慢慢记录，慢慢生长。</span>
    <span>
      文字与记忆 <Icon name="sparkle" size={14} />
    </span>
  </div>
  <section class="latest-writing" aria-labelledby="latest-heading" data-reveal>
    <div class="section-heading">
      <h2 id="latest-heading">
        最近的文字 <span class="section-count">{articles.length} 篇</span>
      </h2>
      <a href="/blog/">
        全部文章 <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="latest-grid">
      {latest.map((article) => (
        <ArticleCard article={article} featured />
      ))}
      <a href="/memory/" class="memory-card card">
        <div class="memory-top">
          <span class="memory-icon">
            <Icon name="memory" size={26} />
            <span>记忆工作区</span>
          </span>
          <span class="pill">只在本机</span>
        </div>
        <h3>
          让一次对话，
          <br />
          成为下一次思考的起点。
        </h3>
        <p>导入对话，整理事实、偏好与决定。把有用的记忆带进下一次对话。</p>
        <span class="memory-link">
          进入记忆库 <Icon name="arrow" size={18} />
        </span>
      </a>
    </div>
  </section>
  <section class="home-note" data-reveal>
    <span class="note-small-icon">
      <Icon name="shield" size={22} />
    </span>
    <div>
      <h2>公开分享文字，私下保存记忆。</h2>
      <p>文章可以被阅读和订阅；对话与记忆只存放在你当前的浏览器里。</p>
    </div>
    <a href="/about/">
      了解这个空间 <Icon name="arrow" size={17} />
    </a>
  </section>
</SiteLayout>
<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding: 4px 0 clamp(36px, 4.2vw, 64px);
  }
  .hero-text,
  .hero-art {
    min-width: 0;
  }
  .hero-text .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: 0.08em;
    margin-bottom: 30px;
  }
  .welcome-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  .hero-text h1 {
    font-family: 'Songti SC', STSong, SimSun, serif;
    font-size: clamp(34px, 4.05vw, 66px);
    line-height: 1.42;
    letter-spacing: -0.075em;
    margin-bottom: 28px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .hero-text h1 span {
    color: var(--accent);
    position: relative;
    isolation: isolate;
  }
  .hero-text h1 span::after {
    content: '';
    position: absolute;
    inset: auto 0 0.04em;
    height: 0.14em;
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    transform: skewX(-15deg);
    z-index: -1;
  }
  .hero-description {
    max-width: 29em;
    font-size: 16px;
    color: var(--muted);
    line-height: 1.95;
    margin-bottom: 30px;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-art {
    width: 100%;
  }
  .home-divider {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid var(--border);
    padding-top: 19px;
    color: var(--muted);
    font-size: 14px;
    margin-bottom: clamp(36px, 4vw, 56px);
  }
  .home-divider > span:last-child {
    display: flex;
    gap: 9px;
    align-items: center;
    font-size: 12px;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }
  .section-count {
    display: inline-block;
    vertical-align: middle;
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0;
    margin-left: 10px;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }
  .memory-card {
    position: relative;
    padding: clamp(24px, 2.5vw, 34px);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 24%, var(--border));
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease-out),
      box-shadow 0.3s;
  }
  .memory-card:focus-visible {
    border-color: var(--accent);
  }
  .memory-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 28px;
  }
  .memory-icon {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--accent);
    font-size: 14px;
  }
  .memory-top .pill {
    background: transparent;
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 22%, var(--border));
    font-size: 12px;
    white-space: nowrap;
  }
  .memory-card h3 {
    font-size: clamp(22px, 2.15vw, 28px);
    line-height: 1.55;
    margin: 0 0 14px;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }
  .memory-card p {
    font-size: 16px;
    line-height: 1.9;
    color: var(--muted);
    margin-bottom: 23px;
    flex: 1;
    text-wrap: pretty;
  }
  .memory-link {
    min-height: 44px;
    font-size: 14px;
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    border-top: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    padding-top: 14px;
  }
  .home-note {
    margin-top: 36px;
    padding: 26px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .note-small-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-soft);
    display: grid;
    place-items: center;
    color: var(--muted);
    flex-shrink: 0;
  }
  .home-note h2 {
    font-size: 15px;
    letter-spacing: 0;
    line-height: 1.7;
    margin-bottom: 4px;
    font-weight: 600;
  }
  .home-note p {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
  }
  .home-note > a {
    margin-left: auto;
    min-height: 44px;
    display: flex;
    gap: 8px;
    align-items: center;
    white-space: nowrap;
    font-size: 14px;
    color: var(--accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .memory-card:hover {
      border-color: var(--accent);
      transform: translateY(-4px);
      box-shadow: 0 22px 40px -30px color-mix(in srgb, var(--accent) 50%, transparent);
    }
  }
  .memory-card:active {
    transform: translateY(0);
  }
  @media (max-width: 1100px) and (min-width: 761px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 25px;
    }
    .hero-text h1 {
      font-size: clamp(40px, 5.8vw, 58px);
    }
    .hero-art {
      max-width: 460px;
      margin: 0 auto;
    }
    .home-note {
      flex-wrap: wrap;
    }
    .home-note > a {
      margin-left: 60px;
    }
  }
  @media (max-width: 860px) {
    .latest-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: 4px 0 29px;
    }
    .hero-text h1 {
      font-size: clamp(32px, 8.7vw, 48px);
      letter-spacing: -0.07em;
      line-height: 1.4;
      margin-bottom: 22px;
    }
    .hero-text .eyebrow {
      margin-bottom: 22px;
      font-size: 12px;
    }
    .hero-description {
      margin-bottom: 24px;
    }
    .hero-art {
      max-width: 430px;
      margin: 0 auto;
    }
    .hero-actions {
      gap: 10px;
    }
    .hero-actions .button {
      padding-inline: 15px;
      flex: 1;
      white-space: nowrap;
    }
    .home-divider {
      font-size: 13px;
      padding-top: 16px;
      margin-bottom: 32px;
    }
    .home-divider > span:last-child {
      font-size: 11px;
      gap: 6px;
    }
    .section-heading {
      gap: 10px;
    }
    .section-count {
      margin-left: 5px;
      font-size: 13px;
    }
    .memory-top {
      margin-bottom: 24px;
    }
    .memory-card h3 {
      font-size: clamp(21px, 5.8vw, 25px);
    }
    .home-note {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 12px;
    }
    .home-note > div {
      flex: 1;
      min-width: 0;
    }
    .home-note > a {
      margin-left: 56px;
      flex-basis: calc(100% - 56px);
    }
  }
</style>
