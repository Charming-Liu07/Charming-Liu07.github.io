---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
---

<SiteLayout title="搜索" description="搜索 Charming 的公开博客文章。" active="blog">
  <header class="page-header">
    <span class="page-number">INDEX / SEARCH</span>
    <p class="eyebrow">FIND THE WORDS</p>
    <h1 class="page-title">
      找一找，
      <br />
      你想读的文字。
    </h1>
    <p>从一个关键词开始，搜索这个小站里的文章。</p>
  </header>
  <section class="search-panel" data-pagefind-ignore>
    <form id="article-search" role="search">
      <label for="search-query">文章关键词</label>
      <div class="search-field">
        <Icon name="search" size={22} />
        <input
          id="search-query"
          type="search"
          name="q"
          placeholder="试试搜索「关于」或「欢迎」"
          autocomplete="off"
        />
        <button class="button" type="submit">
          搜索
          <Icon name="arrow" size={18} />
        </button>
      </div>
    </form>
    <p id="search-status" class="search-status" role="status" aria-live="polite">
      输入关键词，开始寻找。
    </p>
    <ul id="search-results" class="search-results"></ul>
    <noscript>
      <p class="no-script">
        搜索需要启用 JavaScript。你也可以<a href="/archives/">浏览全部文章</a>。
      </p>
    </noscript>
    <div class="search-alternative">
      <span>也可以换一种方式浏览</span>
      <a class="text-link" href="/archives/">
        文章归档
        <Icon name="arrowUp" size={15} />
      </a>
      <a class="text-link" href="/tags/">
        标签索引
        <Icon name="arrowUp" size={15} />
      </a>
    </div>
  </section>
</SiteLayout>
<script is:inline type="module">
  const form = document.querySelector('#article-search');
  const input = document.querySelector('#search-query');
  const status = document.querySelector('#search-status');
  const list = document.querySelector('#search-results');
  let sequence = 0;
  let timer;
  let searchModule;
  async function search() {
    if (!input || !status || !list) return;
    const query = input.value.trim();
    const current = ++sequence;
    list.replaceChildren();
    const url = new URL(window.location.href);
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!query) {
      status.textContent = '输入关键词，开始寻找。';
      return;
    }
    status.textContent = '正在寻找…';
    try {
      // Pagefind is generated after Astro builds, so load it in the browser.
      searchModule ??= import('/pagefind/pagefind.js');
      const pagefind = await searchModule;
      const result = await pagefind.search(query);
      const matches = await Promise.all(result.results.map((match) => match.data()));
      if (current !== sequence) return;
      status.textContent = matches.length
        ? `找到 ${matches.length} 条结果。`
        : '暂时没有找到相关文字，换个关键词试试。';
      for (const match of matches) {
        const item = document.createElement('li');
        item.className = 'search-result';
        const link = document.createElement('a');
        link.href = match.url;
        const title = document.createElement('h2');
        title.textContent = match.meta.title || '阅读文章';
        const excerpt = document.createElement('p');
        const excerptDocument = new DOMParser().parseFromString(match.excerpt || '', 'text/html');
        excerpt.textContent = excerptDocument.body.textContent;
        const path = document.createElement('span');
        path.className = 'result-path';
        path.textContent = new URL(match.url, location.origin).pathname;
        link.append(title, excerpt, path);
        item.append(link);
        list.append(item);
      }
    } catch {
      if (current === sequence)
        status.textContent = '搜索索引暂时不可用，请稍后重试，或通过文章归档浏览。';
    }
  }
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    clearTimeout(timer);
    void search();
  });
  input?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => void search(), 220);
  });
  const initialQuery = new URL(window.location.href).searchParams.get('q');
  if (input && initialQuery) {
    input.value = initialQuery;
    void search();
  }
</script>
<style>
  .search-panel {
    max-width: 920px;
  }
  .search-panel label {
    display: block;
    margin-bottom: 14px;
    font-size: 12px;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 12px 12px 12px 22px;
    border: 1px solid var(--strong-border);
    background: var(--surface);
  }
  .search-field input {
    flex: 1;
    min-width: 0;
    padding: 10px 0;
    font-size: 16px;
    border: 0;
    background: transparent;
  }
  .search-field .button {
    gap: 24px;
  }
  .search-status {
    color: var(--muted);
    font-size: 14px;
    margin: 22px 0 32px;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .search-results :global(.search-result) {
    border-top: 1px solid var(--border);
  }
  .search-results :global(.search-result:last-child) {
    border-bottom: 1px solid var(--border);
  }
  .search-results :global(.search-result a) {
    display: block;
    padding: 30px 0;
  }
  .search-results :global(.search-result a:hover h2) {
    color: var(--accent);
  }
  .search-results :global(h2) {
    font-size: 28px;
    margin-bottom: 16px;
  }
  .search-results :global(p) {
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 18px;
  }
  .search-results :global(.result-path) {
    color: var(--muted);
    font: 10px/1.6 var(--mono);
  }
  .no-script {
    padding: 24px;
    border: 1px solid var(--border);
    font-size: 16px;
  }
  .no-script a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .search-alternative {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .search-alternative > span {
    color: var(--muted);
    font-size: 12px;
    margin-right: auto;
  }
  .search-alternative a {
    font-size: 12px;
  }
  @media (max-width: 700px) {
    .search-field {
      gap: 12px;
      padding: 8px 8px 8px 14px;
    }
    .search-field > svg {
      width: 18px;
      height: 18px;
    }
    .search-field .button {
      padding-inline: 16px;
      min-height: 44px;
      font-size: 13px;
    }
    .search-field .button svg {
      display: none;
    }
    .search-status {
      font-size: 13px;
    }
    .search-alternative {
      gap: 6px 24px;
    }
    .search-alternative > span {
      flex-basis: 100%;
    }
  }
</style>
