---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const tags = [...new Set(articles.flatMap((article) => article.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'zh-CN'),
);
---

<SiteLayout title="标签" description="按标签浏览 Charming 的公开文章。" active="blog">
  <header class="page-header">
    <span class="page-number">INDEX / TOPICS</span>
    <p class="eyebrow">FOLLOW A THREAD</p>
    <h1 class="page-title">
      从一个主题，
      <br />
      读起。
    </h1>
    <p>标签把有关联的文字放在一起。</p>
  </header>
  {tags.length > 0 ? (
    <>
      <nav class="tag-cloud" aria-label="文章标签">
        {tags.map((tag) => (
          <a class="pill" href={`#${encodeURIComponent(tag)}`}>
            # {tag}
            <span>{articles.filter((article) => article.data.tags.includes(tag)).length}</span>
          </a>
        ))}
      </nav>
      <div class="tag-groups">
        {tags.map((tag) => (
          <section id={tag} class="tag-group">
            <h2>
              <span>#</span> {tag}
            </h2>
            <ul>
              {articles
                .filter((article) => article.data.tags.includes(tag))
                .map((article) => (
                  <li>
                    <a href={`/post/${article.id}/`}>
                      <span>{article.data.title}</span>
                      <time datetime={article.data.date.toISOString().slice(0, 10)}>
                        {article.data.date.toISOString().slice(0, 10)}
                      </time>
                      <Icon name="arrowUp" size={18} />
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))}
      </div>
    </>
  ) : (
    <div class="empty-state">
      <p class="eyebrow">[ NO TAGS YET ]</p>
      <h2>还没有文章标签。</h2>
      <p>现有文章未设置标签，你可以先按时间浏览。</p>
      <a href="/archives/" class="button button-secondary">
        前往文章归档
        <Icon name="arrow" size={17} />
      </a>
    </div>
  )}
</SiteLayout>
<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 54px;
  }
  .tag-cloud .pill {
    padding-inline: 16px;
  }
  .tag-cloud span {
    font-size: 10px;
  }
  .tag-group {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 60px;
    margin-bottom: 40px;
    scroll-margin-top: 32px;
  }
  .tag-group h2 {
    font-size: 28px;
    overflow-wrap: anywhere;
  }
  .tag-group h2 > span {
    color: var(--muted);
    font-family: var(--mono);
  }
  .tag-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--strong-border);
  }
  .tag-group li {
    border-bottom: 1px solid var(--border);
  }
  .tag-group a {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
    padding: 16px 0;
  }
  .tag-group a > span {
    flex: 1;
    overflow-wrap: anywhere;
  }
  .tag-group a:hover {
    color: var(--accent);
  }
  .tag-group time {
    font: 10px var(--mono);
    color: var(--muted);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .tag-group {
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 36px;
    }
  }
  @media (max-width: 700px) {
    .tag-group {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .tag-group h2 {
      font-size: 25px;
    }
    .tag-group a {
      gap: 12px;
    }
    .tag-group time {
      font-size: 9px;
    }
  }
</style>
