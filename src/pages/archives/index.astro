---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const years = [...new Set(articles.map((article) => article.data.date.getUTCFullYear()))];
---

<SiteLayout title="归档" active="blog" description="按时间浏览 Charming 的所有公开文章。">
  <header class="page-header">
    <span class="page-number">INDEX / TIME</span>
    <p class="eyebrow">THROUGH THE YEARS</p>
    <h1 class="page-title">
      沿着时间，
      <br />
      翻一翻。
    </h1>
    <p>共 {articles.length} 篇文章。每次落笔，都留下了一点痕迹。</p>
  </header>
  <div class="archive-list">
    {years.map((year) => (
      <section class="archive-year" aria-labelledby={`year-${year}`}>
        <div class="year-heading">
          <h2 id={`year-${year}`}>
            {year}
            <span>_</span>
          </h2>
          <span>
            {articles.filter((article) => article.data.date.getUTCFullYear() === year).length}{' '}
            篇文章
          </span>
        </div>
        <ul>
          {articles
            .filter((article) => article.data.date.getUTCFullYear() === year)
            .map((article) => (
              <li>
                <time datetime={article.data.date.toISOString().slice(0, 10)}>
                  {article.data.date.toISOString().slice(5, 10)}
                </time>
                <a href={`/post/${article.id}/`}>
                  {article.data.title}
                  <Icon name="arrowUp" size={22} />
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}
  </div>
  {articles.length === 0 && (
    <div class="empty-state">
      <h2>还没有文章。</h2>
      <p>新的文字会在这里留下日期。</p>
    </div>
  )}
  <a class="text-link archive-back" href="/blog/">
    浏览全部文章
    <Icon name="arrow" size={17} />
  </a>
</SiteLayout>
<style>
  .archive-year {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 60px;
    margin-bottom: 52px;
  }
  .year-heading h2 {
    margin: 0 0 8px;
    font: 50px/1.2 var(--mono);
    letter-spacing: -0.08em;
  }
  .year-heading h2 span {
    color: var(--pink);
  }
  .year-heading > span {
    color: var(--muted);
    font-size: 11px;
  }
  .archive-year ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--strong-border);
  }
  .archive-year li {
    display: flex;
    align-items: center;
    gap: 32px;
    border-bottom: 1px solid var(--border);
    padding: 20px 0;
  }
  .archive-year time {
    color: var(--muted);
    font: 11px var(--mono);
  }
  .archive-year a {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex: 1;
    font-size: 23px;
    overflow-wrap: anywhere;
  }
  .archive-year a:hover {
    color: var(--accent);
  }
  .archive-back {
    margin-top: 18px;
  }
  @media (max-width: 900px) {
    .archive-year {
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 36px;
    }
  }
  @media (max-width: 700px) {
    .archive-year {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-bottom: 38px;
    }
    .year-heading {
      display: flex;
      align-items: baseline;
      gap: 20px;
    }
    .year-heading h2 {
      font-size: 39px;
    }
    .archive-year li {
      gap: 24px;
      padding-block: 14px;
    }
    .archive-year a {
      font-size: 20px;
    }
  }
</style>
