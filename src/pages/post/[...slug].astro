---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ArticleToc from '../../components/ArticleToc.astro';
export const getStaticPaths = (async () => {
  const articles = await getCollection('blog');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;
interface Props {
  article: CollectionEntry<'blog'>;
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const date = article.data.date.toISOString().slice(0, 10);
const updated = article.data.updated?.toISOString().slice(0, 10);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<SiteLayout
  title={article.data.title}
  description={article.data.description}
  active="blog"
  article={{
    publishedTime: article.data.date.toISOString(),
    modifiedTime: article.data.updated?.toISOString(),
  }}
>
  <div class="reading-bar">
    <a class="text-link" href="/blog/">
      <span>←</span>返回文章
    </a>
    <span>CHARMING / WRITING</span>
  </div>
  <div class:list={{ 'post-layout': true, 'with-toc': toc.length > 0 }}>
    <article class="post" data-pagefind-body>
      <header class="post-header">
        <p class="eyebrow">A PAGE FROM MY BLOG</p>
        <h1 data-pagefind-meta="title">{article.data.title}</h1>
        <div class="post-meta">
          <span>BY CHARMING</span>
          <time datetime={date}>{date}</time>
          {updated && (
            <span>
              更新于 <time datetime={updated}>{updated}</time>
            </span>
          )}
          {article.data.tags.map((tag) => (
            <a class="pill" href={`/tags/#${encodeURIComponent(tag)}`}>
              # {tag}
            </a>
          ))}
        </div>
      </header>
      <div class="post-content prose">
        <Content />
      </div>
      <footer class="post-footer" data-pagefind-ignore>
        <span>谢谢你在这里停留。</span>
        <a class="text-link" href="/blog/">
          继续阅读
          <Icon name="arrow" size={18} />
        </a>
      </footer>
    </article>
    <ArticleToc headings={toc} />
  </div>
</SiteLayout>
<style>
  .reading-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--border);
    margin-top: -24px;
    margin-bottom: 54px;
    padding-bottom: 14px;
  }
  .reading-bar .text-link {
    font-size: 12px;
    gap: 12px;
  }
  .reading-bar > span {
    font: 9px var(--mono);
    color: var(--muted);
  }
  .post-layout {
    max-width: 780px;
    margin: 0 auto;
  }
  .with-toc {
    max-width: 1100px;
    display: grid;
    grid-template-columns: minmax(0, 780px) 190px;
    gap: 80px;
  }
  .post {
    min-width: 0;
  }
  .post-header {
    padding-bottom: 32px;
    margin-bottom: 42px;
    border-bottom: 1px solid var(--strong-border);
  }
  .post-header .eyebrow {
    font-size: 10px;
    color: var(--muted);
  }
  .post-header h1 {
    font-size: clamp(42px, 5.6vw, 74px);
    line-height: 1.25;
    margin-bottom: 32px;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
    font: 10px/1.7 var(--mono);
    color: var(--muted);
  }
  .post-meta > time {
    padding-left: 24px;
    border-left: 1px solid var(--border);
  }
  .prose {
    font-size: 18px;
    line-height: 1.95;
    overflow-wrap: break-word;
  }
  .prose :global(p) {
    margin-bottom: 26px;
    line-height: 1.95;
  }
  .prose :global(h2) {
    font-size: 30px;
    line-height: 1.5;
    margin: 48px 0 22px;
    scroll-margin-top: 32px;
  }
  .prose :global(h3) {
    font-size: 24px;
    line-height: 1.5;
    margin: 38px 0 18px;
    scroll-margin-top: 32px;
  }
  .prose :global(h4) {
    font-size: 20px;
    margin: 30px 0 16px;
    scroll-margin-top: 32px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .prose :global(blockquote) {
    margin: 30px 0;
    padding: 24px 28px;
    border-left: 3px solid var(--pink);
    background: var(--surface-soft);
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 28px;
    margin-bottom: 28px;
  }
  .prose :global(li) {
    margin-bottom: 10px;
  }
  .prose :global(pre) {
    padding: 22px;
    border: 1px solid var(--border);
    overflow: auto;
    font-size: 14px;
    line-height: 1.8;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.87em;
  }
  .prose :global(:not(pre) > code) {
    background: var(--surface-soft);
    border: 1px solid var(--border);
    padding: 2px 5px;
  }
  .prose :global(img) {
    display: block;
    height: auto;
    margin: 32px auto;
  }
  .prose :global(table) {
    display: block;
    overflow: auto;
    border-collapse: collapse;
    width: 100%;
    margin: 28px 0;
    font-size: 15px;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 12px 16px;
  }
  .prose :global(th) {
    background: var(--surface-soft);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 44px 0;
  }
  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    border-top: 1px solid var(--strong-border);
    margin-top: 56px;
    padding-top: 24px;
    font-size: 13px;
  }
  .post-footer > span {
    color: var(--muted);
  }
  .post-footer a {
    font-size: 13px;
  }
  @media (max-width: 1000px) {
    .with-toc {
      grid-template-columns: minmax(0, 1fr) 160px;
      gap: 40px;
    }
  }
  @media (max-width: 800px) {
    .with-toc {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
  }
  @media (max-width: 700px) {
    .reading-bar {
      margin-top: -16px;
      margin-bottom: 34px;
    }
    .reading-bar > span {
      font-size: 8px;
    }
    .post-header {
      padding-bottom: 26px;
      margin-bottom: 30px;
    }
    .post-header h1 {
      font-size: 43px;
      margin-bottom: 24px;
    }
    .post-meta {
      gap: 12px 18px;
      font-size: 9px;
    }
    .post-meta > time {
      padding-left: 18px;
    }
    .prose {
      font-size: 17px;
    }
    .prose :global(blockquote) {
      padding: 20px;
    }
    .prose :global(h2) {
      font-size: 26px;
    }
    .prose :global(h3) {
      font-size: 22px;
    }
    .post-footer {
      margin-top: 40px;
    }
  }
</style>
