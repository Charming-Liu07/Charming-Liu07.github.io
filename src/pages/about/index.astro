---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
---

<SiteLayout
  title="关于"
  description="你好，我是 Charming。欢迎来到我的小站呀，很高兴遇见你！🤝"
  active="about"
>
  <header class="page-header">
    <span class="page-number">HELLO / WORLD</span>
    <p class="eyebrow">A LITTLE ABOUT THIS SPACE</p>
    <h1 class="page-title">
      你好，
      <br />
      我是 Charming<span class="about-period">。</span>
    </h1>
    <p>欢迎来到我的小站呀，很高兴遇见你！🤝</p>
  </header>
  <section class="about-intro" aria-labelledby="about-heading" data-reveal>
    <div class="portrait-panel">
      <img src="/images/avatar.png" alt="Charming 的头像" width="320" height="320" />
      <span>CHARMING / PERSONAL BLOG</span>
    </div>
    <div class="about-copy">
      <p class="eyebrow">NICE TO MEET YOU.</p>
      <h2 id="about-heading">
        欢迎来到
        <br />
        我的小站。
      </h2>
      <p>这里是 Charming 的个人博客。已经写下的文章，可以按时间浏览，也可以通过搜索寻找。</p>
      <a class="text-link" href="/post/about/">
        阅读最初的「关于」
        <Icon name="arrowUp" size={18} />
      </a>
      <p class="original-date">
        FIRST POST / <time datetime="2024-11-02">2024-11-02</time>
      </p>
    </div>
  </section>
  <div class="about-links">
    <a class="text-link" href="/blog/">
      去看看文章
      <Icon name="arrow" size={17} />
    </a>
    <a
      class="text-link"
      href="https://github.com/Charming-Liu07"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
      <Icon name="arrowUp" size={15} />
    </a>
    <a class="text-link" href="/atom.xml">
      订阅 RSS
      <Icon name="arrowUp" size={15} />
    </a>
    <span>cjdl！啦啦啦</span>
  </div>
</SiteLayout>
<style>
  .about-period {
    color: var(--accent);
  }
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 110px);
    padding: 12px 0 58px;
    align-items: center;
  }
  .portrait-panel {
    border: 1px solid var(--strong-border);
    background: var(--pink);
    padding: 36px 36px 18px;
    color: var(--charcoal);
  }
  .portrait-panel img {
    display: block;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0 auto 22px;
    border: 1px solid var(--charcoal);
    filter: saturate(0.8);
  }
  .portrait-panel > span {
    display: block;
    font: 9px/1.6 var(--mono);
    letter-spacing: 0.04em;
  }
  .about-copy .eyebrow {
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 22px;
  }
  .about-copy h2 {
    font-size: clamp(32px, 4vw, 52px);
    margin-bottom: 25px;
  }
  .about-copy > p:not(.eyebrow):not(.original-date) {
    font-size: 16px;
    max-width: 32em;
    color: var(--muted);
    margin-bottom: 22px;
  }
  .original-date {
    margin: 30px 0 0;
    color: var(--muted);
    font: 9px/1.6 var(--mono);
  }
  .about-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 32px;
    border-top: 1px solid var(--strong-border);
    padding-top: 24px;
  }
  .about-links > span {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-bottom: 38px;
    }
    .portrait-panel {
      max-width: 340px;
      width: 100%;
      padding: 26px 26px 16px;
    }
    .portrait-panel img {
      max-height: 260px;
    }
    .about-copy h2 {
      font-size: 36px;
    }
    .about-links {
      gap: 8px 24px;
    }
    .about-links .text-link {
      font-size: 12px;
    }
    .about-links > span {
      flex-basis: 100%;
      margin-top: 16px;
    }
  }
</style>
