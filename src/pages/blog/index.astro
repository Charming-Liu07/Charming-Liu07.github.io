---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<SiteLayout
  title="文章"
  description="Charming 的公开文章。按时间阅读文字，也可通过归档、标签和搜索寻找。"
  active="blog"
>
  <header class="page-header">
    <p class="eyebrow">WRITING & NOTES</p>
    <h1 class="page-title">文字，是思考的回声。</h1>
    <p>一些记录，一些想法。把值得留住的时刻，放在这里。</p>
  </header>
  <div class="article-toolbar">
    <span>
      全部文章 <strong>{articles.length}</strong>
    </span>
    <nav aria-label="文章浏览方式">
      <a href="/archives/">
        <Icon name="archive" size={14} />
        按时间
      </a>
      <a href="/tags/">
        <Icon name="tag" size={14} />
        按标签
      </a>
    </nav>
  </div>
  <div class="article-grid">
    {articles.map((article) => (
      <ArticleCard article={article} />
    ))}
  </div>
  {articles.length === 0 && (
    <div class="empty-state card">
      <h2>文字还在路上。</h2>
      <p>新的文章会出现在这里。</p>
    </div>
  )}
  <div class="subscribe-note">
    <p>喜欢慢慢阅读？</p>
    <a href="/atom.xml">
      通过 RSS 订阅新文章 <Icon name="arrowUp" size={14} />
    </a>
  </div>
</SiteLayout>
<style>
  .article-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    font-size: 14px;
    color: var(--muted);
  }
  .article-toolbar strong {
    font-size: 14px;
    font-weight: 500;
    margin-left: 8px;
    background: var(--surface-soft);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .article-toolbar nav {
    display: flex;
    gap: 19px;
  }
  .article-toolbar a {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 6px;
  }
  .article-toolbar a:hover {
    color: var(--accent);
  }
  .subscribe-note {
    border-top: 1px solid var(--border);
    margin-top: 43px;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--muted);
  }
  .subscribe-note p {
    margin: 0;
  }
  .subscribe-note a {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 8px;
    color: var(--accent);
  }
</style>
