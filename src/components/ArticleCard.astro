---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props {
  article: CollectionEntry<'blog'>;
  featured?: boolean;
}
const { article, featured = false } = Astro.props;
const date = article.data.date.toISOString().slice(0, 10);
const Heading = featured ? 'h3' : 'h2';
---

<article class:list={{ 'article-card': true, featured }}>
  <div class="article-meta">
    <span class="article-label">CHARMING / WRITING</span>
    <time datetime={date}>{date}</time>
  </div>
  <div class="article-copy">
    <Heading>
      <a class="article-title" href={`/post/${article.id}/`}>
        {article.data.title}
      </a>
    </Heading>
    <p>{article.data.description}</p>
    {article.data.tags.length > 0 && (
      <div class="article-tags">
        {article.data.tags.map((tag) => (
          <a class="pill" href={`/tags/#${encodeURIComponent(tag)}`}>
            # {tag}
          </a>
        ))}
      </div>
    )}
  </div>
  <a class="read-link" href={`/post/${article.id}/`} aria-label={`阅读《${article.data.title}》`}>
    <span>阅读文章</span>
    <Icon name="arrowUp" size={26} />
  </a>
</article>
<style>
  .article-card {
    display: grid;
    grid-template-columns: 185px minmax(0, 1fr) 130px;
    gap: 42px;
    align-items: start;
    border-bottom: 1px solid var(--border);
    padding: 38px 0 42px;
  }
  .article-meta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 7px;
    font: 11px/1.5 var(--mono);
    color: var(--muted);
  }
  .article-label {
    font-size: 9px;
    letter-spacing: 0.04em;
  }
  .article-copy {
    min-width: 0;
  }
  h2,
  h3 {
    margin: 0 0 16px;
    font-size: clamp(30px, 3vw, 42px);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .article-title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 7px;
    text-decoration-thickness: 1px;
  }
  .article-title:hover {
    text-decoration-color: currentColor;
  }
  .article-copy p {
    max-width: 44em;
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 0;
    overflow-wrap: anywhere;
  }
  .article-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  .read-link {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 5px;
    font-size: 12px;
  }
  .read-link svg {
    transition: transform 0.2s var(--ease-out);
  }
  .read-link:hover {
    color: var(--accent);
  }
  .read-link:hover svg {
    transform: translate(3px, -3px);
  }
  .featured {
    padding-block: 42px 48px;
  }
  @media (max-width: 1000px) {
    .article-card {
      grid-template-columns: 140px minmax(0, 1fr) 110px;
      gap: 24px;
    }
  }
  @media (max-width: 700px) {
    .article-card {
      grid-template-columns: minmax(0, 1fr) 44px;
      gap: 20px 16px;
      padding-block: 28px 32px;
    }
    .article-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      gap: 16px;
      padding-top: 0;
    }
    h2,
    h3 {
      font-size: 30px;
      margin-bottom: 13px;
    }
    .read-link {
      justify-content: center;
      margin-top: 0;
      width: 44px;
      height: 44px;
      border: 1px solid var(--border);
    }
    .read-link span {
      display: none;
    }
    .read-link svg {
      width: 22px;
      height: 22px;
    }
  }
</style>
